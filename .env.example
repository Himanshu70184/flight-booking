# Frontend API Configuration for Production
# Replace with your backend API URL after deployment
VITE_API_BASE_URL=http://localhost:4003/api

# For Vercel deployment, update this to your deployed backend URL
# Example: https://your-backend.vercel.app/api
# ========== BACKEND API ENVIRONMENT VARIABLES ==========
# These should be configured in Vercel Project Settings for the API deployment

# MongoDB Connection String
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name?retryWrites=true&w=majority

# CORS Configuration - Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173,http://localhost:5176,https://your-frontend-domain.com

# JWT Secret for token signing and verification
JWT_SECRET=your-secret-key-change-in-production

# Default Admin User Credentials (for initial setup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345