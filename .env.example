# Backend API Environment Variables
# Copy this to .env file and fill in the actual values

# Server Configuration
PORT=4000
NODE_ENV=production

# Database Configuration
MONGODB_URI=mongodb+srv://[username]:[password]@[cluster].mongodb.net/[database]?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-very-secure-random-key-change-in-production

# Admin Default Credentials (for initial setup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YourSecurePasswordHere

# CORS Configuration (comma-separated URLs)
# For production: Only your frontend domain
# For development: Include localhost URLs and your Vercel frontend URL
CORS_ORIGIN=https://your-frontend-domain.com,https://www.your-frontend-domain.com,http://localhost:5173,https://your-frontend.vercel.app

# Flight API Configuration (EaseMyTrip)
EASEMYTRIP_API_URL=https://stagingapi.easemytrip.com/Flight.svc/json
EASEMYTRIP_USERNAME=EMTB2B
EASEMYTRIP_PASSWORD=EMT@uytrFYTREt
EASEMYTRIP_IP=127.0.0.1
